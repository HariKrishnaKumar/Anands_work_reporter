# =============================================================================
# Daily Work Report — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# =============================================================================

# --- Application ---
APP_ENV=production
APP_URL=https://your-app.onrender.com
# Empty for Docker/Render, set to /daily-work-report/public for local XAMPP
APP_BASE_PATH=

# --- Database (Aiven MySQL) ---
DB_HOST=your-aiven-host.aivencloud.com
DB_PORT=19433
DB_DATABASE=defaultdb
DB_USERNAME=your-aiven-username
DB_PASSWORD=your-aiven-password

# --- Aiven SSL/TLS ---
# Set to the full path of the Aiven CA certificate file
DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt
# Optional: Set to true to verify the server certificate
DB_SSL_VERIFY=true

# --- Unsplash API ---
# Get your key at https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# --- Google Sheets Integration (disabled in production) ---
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_CREDENTIALS_PATH=storage/google-credentials.json
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WORKSHEET="Work Reports"
